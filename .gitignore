# === Private domain — 가족·심리·번아웃·미공개 의사결정 격리 ===
# 헌법 §VIII 가족 시간 신성화의 데이터 레이어 확장.
# README.md 만 추적(경계 안내문), 내부 파일 전부 격리.
# 정책: shared-memory/context/private-domain-policy.md
shared-memory/_private/*
!shared-memory/_private/README.md
**/_private/*
!**/_private/README.md

# === Secrets — 절대 추적 금지 ===
.env
.env.*
!.env.example
!**/.env.example
*.key
*.pem
credentials*.json
secrets*.json
*token*
*apikey*

# === Claude Code ===
.claude/settings.local.json

# === Python ===
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
*.egg-info/
build/
dist/
.eggs/

# === Node ===
node_modules/
.npm
npm-debug.log*
yarn-debug.log*

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === IDE ===
.vscode/
.idea/
*.swp
*.swo

# === Backup / Temp ===
*~
*.bak
*.tmp
~$*

# === aa-pr 자동 보고서 임시 파일 ===
.aa-pr-body.md
.aa-pr.json

# === Logs ===
*.log
logs/

# === Large binaries ===
*.zip
*.7z
*.tar.gz
*.mp4
*.mov

# === External projects — Alien Agentic과 분리 유지 ===
brain180/

# === Multica 인트라넷 본진 (업스트림 추적, 우리 repo에 포함 X) ===
# 커스터마이즈는 automation/intranet/alien-config/ 에만 두고 push
automation/intranet/multica/

# === Open Design 본진 (업스트림 추적, 우리 repo에 포함 X) ===
# 커스터마이즈(브랜드 디자인시스템·스킬)는 alien-config/open-design/ 에만
automation/intranet/open-design/
