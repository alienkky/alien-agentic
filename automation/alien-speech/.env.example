# Alien Speech 브릿지 환경 변수
# 운용 시 이 파일을 `.env` 로 복사 후 값 채우기. `.env` 는 git 추적 금지.

# ── 브릿지 자체 ─────────────────────────────────────────
BRIDGE_TOKEN=                            # 펌웨어와 공유하는 32바이트 랜덤 비밀
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8788
LOG_LEVEL=INFO

# ── STT ─────────────────────────────────────────────────
STT_MODE=openai-api                      # openai-api | faster-whisper-local
OPENAI_API_KEY=                          # whisper-1 호출용 (기존 Alien Agentic 키 재사용)
WHISPER_MODEL=whisper-1                  # OpenAI 측 모델명
WHISPER_LANGUAGE=ko                      # 한국어 강제 (정확도 ↑)
WHISPER_LOCAL_MODEL=large-v3             # faster-whisper 모드일 때
WHISPER_LOCAL_DEVICE=cuda                # cuda | cpu (RTX 4090 = cuda)
WHISPER_LOCAL_COMPUTE_TYPE=float16       # fp16 권장

# ── Multica (Alien Plan 저장 이슈) ──────────────────────
MULTICA_WORKSPACE_ID=b88c98e5-c9cc-4128-a9cb-02a5a556014d
ALIEN_PLAN_ISSUE_TITLE=🛸 Alien Plan 저장소 (자동 — 수정·삭제 금지)
MULTICA_CLI=multica                      # PATH 안에 있으면 그대로. 절대경로도 가능.
ALIEN_PLAN_PARENT_ISSUE_ID=4b2192a9-a7dc-4875-8091-f470f7c50ea5  # ALI-88 — daily digest 코멘트 타깃

# ── 모니터·알림 ─────────────────────────────────────────
DISCORD_WEBHOOK_ALERTS=                  # Discord #alerts 채널 webhook (docs/guides/discord-webhook.md)
MONITOR_STUCK_SECONDS=300                # 5분 — 메모 1건 처리 임계
MONITOR_STRIKE_LIMIT=3                   # 연속 실패 3회 → 2차 알림
MENTION_OWNER_MEMBER_ID=3bf03b6e-fdb3-46bb-a7a9-da4ef9d316ab     # 기영님
MENTION_OWNER_AGENT_ID=cd966ed7-63ff-40af-b082-b957cbd3c917      # 공도율
DAILY_DIGEST_HOUR_KST=17                 # 17:45 KST 보고
DAILY_DIGEST_MIN_KST=45
DAILY_DIGEST_ENABLED=true                # 운영 첫 1주만 true. 안정화 후 false.

# ── 경로 ────────────────────────────────────────────────
DATA_DIR=                                # 비우면 automation/alien-speech/ 와 동일 폴더
LOG_DIR=                                 # 비우면 DATA_DIR/logs
CACHE_DIR=                               # 비우면 DATA_DIR/.cache
