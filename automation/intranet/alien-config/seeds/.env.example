# Multica 시드용 환경변수 — 수작업 경로 전용
#
# 권장: 이 파일 대신 `aa seed` 한 명령을 쓰세요 (ID 자동 탐색 + 런타임 자동 생성).
# 이 .env 는 `python seed_agents.py` 를 직접 돌릴 때만 필요합니다.
#
# 채우는 법은 alien-config/README.md 3~5단계 참조.

# Multica PostgreSQL 연결 문자열 (postgres 포트가 호스트에 노출돼 있어야 함)
DATABASE_URL=postgres://multica:multica@localhost:5432/multica?sslmode=disable

# 시드 대상 워크스페이스 UUID — README 3단계 psql 조회
WORKSPACE_ID=

# 27명의 owner_id 로 박을 사용자 UUID — README 3단계 psql 조회
OWNER_ID=

# agent.runtime_id 로 박을 agent_runtime UUID — README 4단계에서 생성 후 조회
RUNTIME_ID=
