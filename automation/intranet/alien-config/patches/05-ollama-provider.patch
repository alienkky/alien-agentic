+// defaultOllamaURL is the localhost endpoint we probe when neither
+// MULTICA_OLLAMA_URL nor MULTICA_OLLAMA_PATH is set. Matches the upstream
+// Ollama default — operators on a different host/port override via
+// MULTICA_OLLAMA_URL=http://host:port (no rebuild).
+const defaultOllamaURL = "http://localhost:11434"
+
+// ollamaProbeTimeout caps the daemon-startup HTTP probe to Ollama. If the
+// server is unreachable within this window we silently skip ollama
+// registration rather than blocking the daemon — same behaviour as a CLI
+// that isn't installed.
+const ollamaProbeTimeout = 1500 * time.Millisecond
+
+// probeOllama returns an AgentEntry pointing at a reachable Ollama server
+// (Path = URL, Model = env override) when /api/version answers within the
+// timeout. Unreachable → (zero, false), no error logged: an Ollama-less
+// host is the common case and shouldn't spam stderr.
+func probeOllama() (AgentEntry, bool) {
+	rawURL := strings.TrimSpace(os.Getenv("MULTICA_OLLAMA_URL"))
+	if rawURL == "" {
+		rawURL = strings.TrimSpace(os.Getenv("MULTICA_OLLAMA_PATH"))
+	}
+	if rawURL == "" {
+		rawURL = defaultOllamaURL
+	}
+	rawURL = strings.TrimRight(rawURL, "/")
+	if !strings.HasPrefix(rawURL, "http://") && !strings.HasPrefix(rawURL, "https://") {
+		return AgentEntry{}, false
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), ollamaProbeTimeout)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, "GET", rawURL+"/api/version", nil)
+	if err != nil {
+		return AgentEntry{}, false
+	}
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		return AgentEntry{}, false
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode/100 != 2 {
+		return AgentEntry{}, false
+	}
+	return AgentEntry{
+		Path:  rawURL,
+		Model: strings.TrimSpace(os.Getenv("MULTICA_OLLAMA_MODEL")),
+	}, true
+}
